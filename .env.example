APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

# Set to true only for the first deploy (or after a migration is added),
# then flip back to false. See docker/start.sh.
RUN_MIGRATIONS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# stderr, not stack/file: Render has no persistent disk, so a log file
# written inside the container never shows up in the dashboard's Logs tab.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Aiven MySQL (free Developer Tier). Get these values from the Aiven
# console's "Overview" tab for your MySQL service.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Aiven requires TLS. Download the service's CA certificate from the Aiven
# console and set this to its path inside the container
# (see docker/start.sh / Dockerfile — it's copied to /etc/ssl/certs/aiven-ca.pem).
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/aiven-ca.pem

# --- Backups (php artisan db:backup) — see project.md §15.9 ---
#
# Path to mysqldump. NOTE: XAMPP's mysqldump.exe is MariaDB 10.4, a different
# product line from MySQL — db:backup REFUSES to use it against a MySQL server,
# because a MariaDB client cannot be trusted to produce a restorable dump of
# MySQL 8 (utf8mb4_0900_ai_ci alone means nothing to it). Leave this blank and
# the command finds a real MySQL client itself; set it if yours is elsewhere.
#MYSQLDUMP_PATH="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe"
# Where dumps are written. Gitignored. NOT a backup on its own — copy them off
# this machine; Render's filesystem is ephemeral and this one is one disk.
#BACKUP_PATH=
#BACKUP_KEEP=30

# Required to run migrate:fresh / migrate:reset / migrate:rollback / db:wipe
# against a NON-LOCAL database. Those commands destroy the schema and everything
# in it, and CLAUDE.md documents `migrate:fresh --seed --force --database=aiven`
# as routine — so one mistyped flag used to be unrecoverable. Set it for the one
# command, then unset it. Take a backup first.
#ALLOW_DESTRUCTIVE_MIGRATIONS=false

# Passwords for the three accounts `php artisan db:seed` creates (admin,
# staff, and a sample customer). They used to be literals inside
# database/seeders/AdminSeeder.php, which meant the production admin password
# was readable by anyone with the repository — and because they sat in
# updateOrCreate()'s UPDATE array, re-running the seeder silently reset a
# password that had been rotated by hand.
#
# There is no default. The seeder throws and names the missing variable rather
# than inventing a value, because a default here is a published credential.
# Only read when an account is CREATED — setting a new value does NOT rotate
# an existing password; use the app's own password form for that.
#
# Not needed on Render: the container runs `migrate --force`, never `--seed`.
# Seeding is a developer-machine operation (`--database=aiven`).
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure flag on the session + "Keep me signed in" cookies. Leave this unset
# and config/session.php turns it on by itself whenever APP_ENV=production, so
# a missing variable can no longer silently ship cookies over plain http. Set
# it to false ONLY for an https-less production-like host.
# SESSION_SECURE_COOKIE=true
# Leave this at lax. "strict" breaks the PayMongo return redirect and emailed
# verification links — config/session.php explains why.
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Redis first, MySQL (the `database` store) whenever Redis can't answer —
# the `failover` store in config/cache.php, see project.md v7.4. Safe with
# no Redis at all: every cache call just falls through to MySQL.
CACHE_STORE=failover
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis, not phpredis: neither the Docker image nor XAMPP has the `redis`
# PHP extension, so phpredis fails with "Class Redis not found".
# Production: REDIS_URL = the Render Key Value instance's INTERNAL URL
# (redis://red-...:6379) and REDIS_CACHE_DB=0.
# Local: leave REDIS_URL unset and run `docker compose up -d redis`.
REDIS_CLIENT=predis
# REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_CACHE_DB=1
# Seconds before a Redis call counts as failed. predis's own default is 5,
# per command — a dead Redis would stall every page before falling back.
REDIS_TIMEOUT=0.5

# Switch transports by changing MAIL_MAILER ONLY, then run:
#     php artisan config:clear
# Verify the switch with:  php artisan mail:test you@example.com
#
#   smtp  → any SMTP host (settings below). THE LOCAL DEV DEFAULT.
#   brevo → Brevo's HTTPS API. Needs MAILER_DSN. PRODUCTION ONLY.
#   log   → writes the email to storage/logs, sends nothing.
#
# Render's free plan blocks outbound traffic on SMTP ports (25/465/587)
# entirely — Gmail SMTP, Brevo's own SMTP relay, any host, all blocked the
# same way. So PRODUCTION MUST USE MAIL_MAILER=brevo (HTTPS, not blocked).
MAIL_MAILER=smtp

# --- smtp transport ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Gmail: an App Password, not the account password. Brevo's relay: the
# SMTP key ("xsmtpsib-...") — and note the relay's login is the one Brevo
# issues (SMTP & API -> SMTP -> "Login"), NOT your own email address.
MAIL_PASSWORD=

# --- brevo transport (HTTPS API) — PRODUCTION ONLY ---
# Leave this blank locally. Render sets it in its own dashboard (see
# render.yaml); MAIL_MAILER=brevo without it throws a clear error.
# The key inside the DSN is an API v3 key from Brevo -> SMTP & API ->
# API keys: it starts with "xkeysib-", and is a DIFFERENT credential
# from the "xsmtpsib-" SMTP key above.
#MAILER_DSN=brevo+api://YOUR_BREVO_API_V3_KEY@default

# Must be a sender Brevo has verified, or the API accepts the call and
# then silently never delivers.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Free-tier cron workaround (see routes/cron.php). Any random string works —
# Render can auto-generate this (see render.yaml).
#
# THE PINGER MUST SEND THIS AS A HEADER, NOT IN THE URL:
#
#     GET https://<host>/cron/run-schedule
#     X-Cron-Secret: <CRON_SECRET>
#
# In cron-job.org that is Advanced → Headers. The old URL form
# (/cron/run-schedule/<secret>) still works so a deploy can't silently stop
# the scheduler, but it logs "Deprecated cron secret in URL path" on every
# call — a path segment ends up in access logs, in Render's log stream and in
# the cron service's own history, none of which are built to hold secrets.
# Once that warning stops appearing, the legacy routes can be deleted.
CRON_SECRET=

# Cloudinary storage for property images (Render's disk is ephemeral).
# Leave blank to keep using local disk storage (e.g. local dev).
# Cloudinary dashboard -> Home -> "API Environment variable" box gives you
# this whole string ready to paste: cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_URL=

# Realtime dashboard (admin/partials/realtime.blade.php). Set to "pusher"
# once the four PUSHER_* values below are filled in — "log" just writes
# broadcast events to the log file instead of sending them, so the
# dashboard stays silent but nothing errors.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# PayMongo (test-mode keys while testing)
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
# Ang webhook secret ay PER-MODE — magkaibang `whsk_...` ang binibigay
# ng PayMongo sa isang test-mode at sa isang live-mode na webhook.
# Itakda ang generic kung iisang mode lang ang pinapatakbo; itakda
# ang _TEST at/o _LIVE kung magkasabay silang naka-rehistro sa
# iisang URL. Ang maling pares ay nangangahulugang bigo ang
# signature ng bawat delivery, at dini-disable ng PayMongo ang
# endpoint kapag paulit-ulit iyon. Tingnan: php artisan paymongo:webhooks
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_WEBHOOK_SECRET_TEST=
PAYMONGO_WEBHOOK_SECRET_LIVE=
# Aling webhook ang sinusundan ng `paymongo:tunnel`. Kung blangko,
# hinuhulaan ito mula sa host na ibinibigay ng ngrok ngayon.
PAYMONGO_TUNNEL_WEBHOOK=
# Purpose code sent with every Send Money (refund) transfer. Leave unset
# for the default, 'customer-refund'. This is the field that decides
# whether GCash accepts a transfer — see App\Models\RefundTransfer::PURPOSE.
# PAYMONGO_TRANSFER_PURPOSE=

# AI chatbot (Portal/ChatbotController)
# Which provider GeminiService::ask() calls: groq | gemini (default groq).
# Change it, then run `php artisan config:clear`.
AI_PROVIDER=groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=  # default minimal — thinking tokens count against maxOutputTokens; 'omit' sends none

GROQ_API_KEY=
GROQ_MODEL=
# GROQ_REASONING_EFFORT=  # auto-derived per model; gpt-oss: low|medium|high, qwen: none|default, compound: omit
ANTHROPIC_API_KEY=

VITE_APP_NAME="${APP_NAME}"
