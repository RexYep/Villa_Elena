APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

# Set to true only for the first deploy (or after a migration is added),
# then flip back to false. See docker/start.sh.
RUN_MIGRATIONS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# stderr, not stack/file: Render has no persistent disk, so a log file
# written inside the container never shows up in the dashboard's Logs tab.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Aiven MySQL (free Developer Tier). Get these values from the Aiven
# console's "Overview" tab for your MySQL service.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
# Aiven requires TLS. Download the service's CA certificate from the Aiven
# console and set this to its path inside the container
# (see docker/start.sh / Dockerfile — it's copied to /etc/ssl/certs/aiven-ca.pem).
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/aiven-ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Not used in production (no free Redis provider wired up on Render yet —
# CACHE_STORE stays `database` above for live). Locally, set CACHE_STORE=redis
# and REDIS_CLIENT=predis, then `docker compose up -d redis` to run a local
# Redis server for caching.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Render's free plan blocks outbound traffic on SMTP ports (25/465/587)
# entirely — Gmail SMTP, Brevo's own SMTP relay, any host, all blocked the
# same way. So mail goes through Brevo's HTTPS API instead (not blocked).
# Brevo dashboard -> Settings -> SMTP & API -> API Keys -> generate one.
MAIL_MAILER=brevo
MAILER_DSN=brevo+api://YOUR_BREVO_API_KEY@default
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Free-tier cron workaround (see routes/web.php /cron/run-schedule/{token}).
# Any random string works — Render can auto-generate this (see render.yaml).
CRON_SECRET=

# Cloudinary storage for property images (Render's disk is ephemeral).
# Leave blank to keep using local disk storage (e.g. local dev).
# Cloudinary dashboard -> Home -> "API Environment variable" box gives you
# this whole string ready to paste: cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_URL=

# Realtime dashboard (admin/partials/realtime.blade.php). Set to "pusher"
# once the four PUSHER_* values below are filled in — "log" just writes
# broadcast events to the log file instead of sending them, so the
# dashboard stays silent but nothing errors.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# PayMongo (test-mode keys while testing)
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Purpose code sent with every Send Money (refund) transfer. Leave unset
# for the default, 'customer-refund'. This is the field that decides
# whether GCash accepts a transfer — see App\Models\RefundTransfer::PURPOSE.
# PAYMONGO_TRANSFER_PURPOSE=

# AI chatbot (Portal/ChatbotController)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_REASONING_EFFORT=  # auto-derived per model; gpt-oss: low|medium|high, qwen: none|default, compound: omit
ANTHROPIC_API_KEY=

VITE_APP_NAME="${APP_NAME}"
